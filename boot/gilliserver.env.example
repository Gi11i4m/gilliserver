# Copy to the boot partition as `gilliserver.env` (FAT32, so you can edit it from a
# laptop with the SD card in hand). It holds every secret gilliserver needs, and it
# is the ONLY place they live — this repo is public.
#
# Read by scripts/apply.sh and every module. Shell syntax, no spaces around `=`.
# Add new names here (name and comment only, never a value).

# Pre-authorised key from https://login.tailscale.com/admin/settings/keys
# Used once, to join the tailnet. Make it reusable + tagged if you reflash often.
TAILSCALE_AUTHKEY=

# The key Omnigent's agents run with.
ANTHROPIC_API_KEY=
